  </div>

  <style lang="scss">
    .container {
      padding: 40px 20px 60px;
      max-width: 800px;
      margin: 0 auto;
      font-size: 1.25rem;

      p {
        padding: 20px 0;
        font-weight: 500;
      }

      ul {
        padding-left: 2rem;
        list-style: none;

        li {
          padding-top: 1rem;
          text-indent: -1em;
          padding-left: 1em;
        }
      }

      h2 {
        margin: 0 0 3rem;
        font-size: 2rem;
        font-weight: bold;
        font-size: 2.5rem;
        border-left: 3px solid;
        padding-left: 1rem;
        color: $primary-300;
      }

      h3 {
        margin: 4rem 0 2rem;
        text-align: center;
        padding-bottom: 15px;
        font-weight: 500;
      }

      h4 {
        margin: 4rem 0 2rem;
        color: $primary-300;
        font-weight: 500;
        font-size: 1.5rem;
      }

      table {
        width: 100%;
        margin-bottom: 1rem;
        vertical-align: top;
        border-color: #dee2e6;
        caption-side: bottom;
        border-collapse: collapse;
        font-size: 1rem;
        text-align: center;

        tr,
        th,
        td {
          padding: 10px;
          font-weight: 500;
          border-color: inherit;
          border-style: solid;
          border-width: 1px 1px;
        }
      }

      section {
        padding: 2rem 0;
      }

      .text-primary {
        color: $primary-300;
      }

      .red {
        color: rgb(220, 53, 69);
      }

      .top-section {
        height: calc(100vh - 80px);
        display: flex;
