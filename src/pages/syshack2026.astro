---
import Layout from '@/layouts/Layout.astro';
import { Image } from 'astro:assets';
import code from '@/assets/syshack/code.svg';
import jack from '@/assets/syshack/jack.png';
import jougiken from '@/assets/syshack/jougiken.svg';
import syshack from '@/assets/syshack/syshack2026_thumbnail.png';
import cyberagent from '@/assets/syshack/cyberagent.webp';
import techtrain from '@/assets/syshack/techtrain.svg';
import ait from '@/assets/syshack/ait.webp';
import terminal from '@/assets/syshack/terminal.svg';
import dmm from '@/assets/syshack/dmm_com.png';
import churadata from '@/assets/syshack/churadata.png';
import dip from '@/assets/syshack/dip.png';
---

<Layout title="SysHack2026">
  <div class="container">
    <section class="top-section">
      <div>
        <Image src={syshack} alt="SysHack 2026" />
      </div>
    </section>

    {/* 昨年度のページはこちら */}
    <section class="text-center mb-5">
      <a class="text-primary" href="/syshack2025" rel="noopener noreferrer">SysHack2025のページはこちら</a>
    </section>

    {/* お知らせ */}
    <section class="notice-section">
      <h2>お知らせ🔔</h2>

      <div class="notice-textbox">
        <div class="border border-primary border-2 border-start-0 border-end-0 mb-4">
          <h3 class="text-center pt-2">SysHack 勉強会のご案内</h3>
          <p class="p-2">
            SysHackでは、参加者のスキルアップを応援する勉強会をオンライン（Discord）で開催します！
            参加者なら誰でも参加可能な勉強会をご用意しています。
          </p>
        </div>

        <div class="accordion">
          <div>
            <div class="accordion-content">
              <h4 class="red">Discordの参加方法は後日Slackにてご連絡します</h4>

              <div>
                <h5>Webフロント勉強会</h5>
                <ul>
                  <li>日時: 2/17(火) 14:00 ~ 16:00, 2/18(水) 14:00 ~ 16:00</li>
                  <li>内容: Web開発の基礎を学び、ハッカソンで活用できるスキルを身につけます。</li>
                </ul>
              </div>

              <div>
                <h5>Android勉強会</h5>
                <ul>
                  <li>日時: 2/25(水) 14:00 ~ 16:00</li>
                  <li>内容: Androidアプリの制作のための基礎を学べます｡</li>
                </ul>
              </div>

              <div>
                <h5>バックエンド勉強会</h5>
                <ul>
                  <li>日時: 3/2(月) 14:00 ~ 16:00, 3/3(火) 14:00 ~ 16:00</li>
                  <li>内容: バックエンドを構築するための基礎を学べます｡</li>
                </ul>
              </div>

              <div>
                <h5>GitHub勉強会</h5>
                <ul>
                  <li>日時: 3/4(火) 14:00 ~ 16:00</li>
                  <li>内容: チーム開発やプロジェクト管理に役立つGit,GitHubについての基礎を学べます。</li>
                </ul>
              </div>

              <div>
                <h5>Unity勉強会</h5>
                <ul>
                  <li>日時: 3/11(水) 14:00 ~ 17:00</li>
                  <li>内容: ゲーム開発に必要な基礎を学べます。</li>
                </ul>
              </div>
            </div>

            <div class="accordion-content">
              <div>
                <h5>アイデア出しサポート</h5>
                <ul>
                  <li>日時: 3/18 (火) 〜 20 (木) 15:00 ~ 23:00</li>
                  <li>場所: Discord</li>
                  <li>
                    内容:
                    初めてのハッカソンで何を作ればいいのかわからない方に向けに､運営陣がDiscordに常駐していますので､お気軽にご相談ください
                    💪
                    <br />
                    作るものが思いつかない､アイデアは思いついたけど賞が取れるか不安､やりたいことが技術的に可能かわからないなど、何でもご相談ください｡
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </div>
        <p class="comment">どの勉強会も気軽にご参加いただける内容となっています。ぜひご活用ください！</p>
      </div>
    </section>

    {/* 概要 */}
    <section class="overview-section">
      <h2>SysHackとは？</h2>

      <div>
        <h3>SysHack : 学生エンジニアのための挑戦の場</h3>

        <p>
          SysHackは、愛知県にある愛知工業大学の学生エンジニア団体「システム工学研究会」が主催する、学生向けのハッカソンです。学生向けのハッカソンです。
        </p>
        <p>こんなふうに感じたことはありませんか？</p>

        <ul>
          <li>初心者向けのハッカソンが少なく、最初の一歩を踏み出しにくい。</li>
          <li>企業主催のイベントに参加するハードルが高い。</li>
          <li>技術選定やテーマに沿ったアイデアを考える際、周囲の視線や審査員の評価を気にしてしまう。</li>
        </ul>

        <p>そんな方におすすめのイベントです！</p>
        <p>SysHackは「初心者の挑戦の場」として、以下の特徴を備えています！</p>
        <ul>
          <li>
            独自の評価基準で作品愛を評価！ 技術力だけでなく、参加者がどれだけ自分の作品に情熱を注いだかを重視します。
          </li>
          <li>昨年度の参加者は大学1・2年生（B1・B2）のみでした。初めてのハッカソン参加にピッタリの環境です。</li>
          <li>すべて学生による運営！ 同じ学生目線で、参加者が安心して挑戦できるイベントを提供します。</li>
        </ul>

        <p>
          SysHackは初心者の挑戦を全力で応援します！新たな技術やアイデアに挑戦したい学生エンジニアの皆さん、ぜひご参加ください！
        </p>
      </div>
    </section>

    {/*  企業 */}
    <section class="sponsor-section">
      <h2>協力企業・学生団体(順不同)</h2>

      <p>SysHackは以下の企業様にご支援をいただいています</p>

      <div class="sponsor-list">
        <div>
          <img alt="TechTrain様" src={techtrain.src} />
          <p>株式会社TechBowl様</p>
        </div>

        <div>
          <img alt="CyberAgent様" src={cyberagent.src} />
          <p>株式会社サイバーエージェント様</p>
        </div>

        <div>
          <img alt="合同会社DMM.com様" src={dmm.src} />
          <p>合同会社DMM.com様</p>
        </div>

        <div>
          <img alt="ちゅらデータ様" src={churadata.src} />
          <p>ちゅらデータ株式会社様</p>
        </div>

        <div>
          <img alt="ディップ株式会社" src={dip.src} />
          <p>ディップ株式会社</p>
        </div>

        <div class="org">
          <img alt="C0de様" src={code.src} />
          <p class="mt-3">C0de様</p>
        </div>

        <div class="org">
          <img alt="jack様" src={jack.src} />
          <p class="mt-3">jack様</p>
        </div>

        <div class="org">
          <img alt="情報技術研究会様" src={jougiken.src} />
          <p class="mt-3">情報技術研究会様</p>
        </div>

        <div class="org">
          <img alt="Terminal" src={terminal.src} />
          <p class="mt-3">Terminal様</p>
        </div>

        <p>協力企業・学生団体は<wbr />増える可能性があります🔥</p>
      </div>

      {/*  賞 */}
      <section class="award-section">
        <h2>賞について</h2>

        <h4>総合賞</h4>
        <ul>
          <li>最優秀賞</li>
        </ul>

        <h4>企業・学生団体賞</h4>
        <ul>
          <li>TechTrain賞</li>
          <li>CyberAgent賞</li>
          <li>DMM.com賞</li>
          <li>ちゅらデータ賞</li>
          <li>ディップ賞</li>
          <li>C0de賞</li>
          <li>jack賞</li>
          <li>情報技術研究会賞</li>
        </ul>

        <p>
          賞の内容は当日発表予定です。
          <br />
          現在も協力企業・学生団体様を募集中のため<wbr />追加される可能性がございます🔥
        </p>
      </section>

      {/* 評価基準 */}
      <section>
        <h2>評価基準</h2>
        <p>審査では, 次の項目を 5 点満点で評価し, 合計点の高い順に順位を決定いたします.</p>

        <ul>
          <li>作品愛: チームが示した独自性や着想, 作品の魅力(“推しポイント”)</li>
          <li>技術的挑戦: チームが取り組んだ技術的な難易度や新規性, 問題解決の工夫</li>
          <li>サービス価値: 実際の利用における有用性, あるいは利用者に提供する面白さや価値</li>
          <li>完成度: 機能の実装状況や安定性, ユーザー体験(操作性・デザイン)の完成度</li>
        </ul>
        <p>以上の観点から<wbr />作品を評価させていただきます🔥</p>
      </section>

      {/*  参加申し込み */}
      <section class="about-registration-section">
        <h2>参加申し込み</h2>

        <h4>チーム参加</h4>

        <ul>
          <li>1チーム 3〜5人です。 connpassで参加申し込みをお願いいたします。メンバー全員必須となります。</li>
          <li>申し込み後に必ず専用Slackにご参加ください。</li>
          <li>チャンネルに記載されているチーム登録フォームから、チーム登録をお願いいたします。</li>
        </ul>

        <h4>個人参加</h4>
        <p>※個人参加の場合、運営でチーム決定をさせていただきます。</p>

        <ul>
          <li>1チーム 3〜5人です。 connpassで参加申し込みをお願いいたします。</li>
          <li>申し込み後に必ず専用Slackにご参加ください。</li>
          <li>
            チャンネルに記載されているチーム登録フォームから、個人参加の旨をご記入の上、チーム決定フォームを提出してください。
          </li>
          <li>チームが確定しましたら、Slack内でご確認の程よろしくお願いいたします。</li>
        </ul>
      </section>

      {/*  参加資格 */}
      <section class="entry-qualification-section">
        <h2>参加資格</h2>
        <h4>対象</h4>
        <ul>
          <li>ハッカソン参加経験2回以下</li>
          <li>エンジニア歴2年未満</li>
        </ul>

        <p>愛知工業大学やシステム工学研究会に所属していない方でも参加可能です🔥</p>

    
        <p>
          上記の条件を満たしていない方でも、<b>チームの中で1名のみ参加可能となっております。</b>
          <wbr />
なお、初心者向けのハッカソンとなっておりますので常識範囲内のご配慮をお願いいたします。
</p>
        <p>
          その他、参加要件を満たしていないと判断した場合は、誠に恐れ入りますが参加をご遠慮ください。
          <br />
          なお、メンター枠をご用意しておりますので、よろしければそちらでのご参加をご検討ください。
        </p>

        <p>
          参加条件に関してわからないことがあれば
          <a class="link-offset-2" href="https://x.com/set_official" target="_blank" rel="noopener noreferrer">公式X</a
          >または
          <a
            class="link-offset-2"
            href="https://www.instagram.com/ait.sysken/"
            target="_blank"
            rel="noopener noreferrer">公式Instagram</a
          >
          のDM等でご連絡ください🔥
        </p>

        <p class="comment">
          ※ キックオフの参加が難しい場合は、運営までご相談ください。
          <br />
          ※ 違反が発覚した場合、チームメンバー全員は参加を辞退していただきます。
        </p>
      </section>

      <section class="question-section">
        <h2>よくある質問</h2>
        <h4>Q. 以前に作成したプロダクトで参加することは可能ですか？</h4>
        <p>A. 不可となります。開発期間中に制作したものに限ります。</p>
        
        <h4>Q. 開発テーマはいつ発表されますか？</h4>
        <p>A. テーマはありません。プログラミングを用いたものであれば、なんでも大丈夫です。</p>
        
        <h4>Q. ハッカソン経験が浅く、自信がないのですが大丈夫ですか？</h4>
        <p>A. 大丈夫です！メンターが複数人いますので、安心してご参加ください。</p>
        
        <h4>Q. 昼食はでるのでしょうか？</h4>
        <p>A. 昼食のご用意はありませんので、持ってきていただくか、構内のコンビニをご利用ください。</p>

      </section>

      {/* 開催場所 */}
      <section class="location-section">
        <h2>開催場所</h2>

        <div class="location">
          <div class="location-img">
            <Image src={ait} alt="愛知工業大学" />
          </div>

          <div class="location-text">
            <h3 class="title">会場</h3>
            <p class="name">愛知工業大学 八草キャンパス</p>
            <p class="address">〒470-0356 愛知県豊田市八草町八千草１２４７</p>
          </div>
        </div>

        <p>開催場所は変更する可能性がございます</p>
      </section>

      {/*  スケジュール */}
      <section>
        <h2>スケジュール</h2>
        <table>
          <thead>
            <tr>
              <th scope="col">月日</th>
              <th scope="col">イベント</th>
              <th scope="col">場所</th>
            </tr>
          </thead>

          <tbody>
            <tr>
              <td>2026年3月8日(日)</td>
              <td>参加締切･チーム決定フォーム提出締切</td>
              <td>-</td>
            </tr>
            <tr>
              <td>2026年3月17日(火)</td>
              <td>キックオフ</td>
              <td>オンライン…Zoom、オフライン…愛知工業大学</td>
            </tr>
            <tr>
              <td>↓</td>
              <td>開発期間</td>
              <td>-</td>
            </tr>
            <tr>
              <td>2026年3月31日(火)</td>
              <td>発表会・懇親会</td>
              <td>現地／愛知工業大学</td>
            </tr>
          </tbody>
        </table>
      </section>

      {/*  タイムテーブル */}
      <section class="event-timetable-section">
        <h2>タイムテーブル</h2>

        <h4>キックオフ(オンライン可)<span class="date">3月17日(火)</span></h4>
        <table>
          <thead>
            <tr>
              <th>時間</th>
              <th>内容</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>17:00</td>
              <td>参加者受付開始</td>
            </tr>
            <tr>
              <td>17:45</td>
              <td>オンライン開場</td>
            </tr>
            <tr>
              <td>18:00</td>
              <td>開会挨拶・イベント概要説明</td>
            </tr>
            <tr>
              <td>18:10</td>
              <td>ルール・評価基準説明</td>
            </tr>
            <tr>
              <td>18:20</td>
              <td>スポンサー紹介</td>
            </tr>
            <tr>
              <td>18:30</td>
              <td>チーム編成・自己紹介</td>
            </tr>
            <tr>
              <td>19:00</td>
              <td>キックオフ終了・zoom 閉場</td>
            </tr>
          </tbody>
        </table>

